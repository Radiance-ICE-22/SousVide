      "type": "file",
      "name": "train_policy.py",
      "filePath": "src/sousvide/instruct/train_policy.py",
      "summary": "Orchestrates supervised training of student policy networks: regenerates observation data if requested, runs per-student training loops with checkpointing, periodic in-training flight evaluation via deploy_figs, best-checkpoint selection, and rich progress reporting.",
      "tags": ["training", "orchestration", "entry-point", "pipeline"],
      "complexity": "complex",
      "languageNotes": "Uses contextlib.redirect_stdout with an io.StringIO buffer to silence noisy deploy_roster output during periodic in-training evaluation."
    },
    {
      "id": "function:src/sousvide/instruct/train_policy.py:train_roster",
