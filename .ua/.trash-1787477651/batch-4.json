      "tags": ["utility", "factory", "training"],
      "complexity": "simple"
    },
    {
      "id": "file:src/sousvide/synthesize/observation_generator.py",
      "type": "file",
      "name": "observation_generator.py",
      "filePath": "src/sousvide/synthesize/observation_generator.py",
      "summary": "Generates neural-network training observations by replaying recorded flight rollout and image data through a Pilot's ORCA control loop with randomized noise injection, then compresses and saves the resulting input/output tensors per pilot network to disk.",
      "tags": ["data-generation", "synthesis", "pipeline", "training-data"],
      "complexity": "complex",
      "languageNotes": "Injects Gaussian position/velocity noise around ground-truth trajectories to synthesize a richer training distribution for imitation-learning-style policy supervision."
    },
