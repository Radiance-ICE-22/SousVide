  "nodes": [
    {
      "id": "file:src/sousvide/control/pilot.py",
      "type": "file",
      "name": "pilot.py",
      "filePath": "src/sousvide/control/pilot.py",
      "summary": "Defines the Pilot class, a BaseController subclass implementing the OODA (Observe-Retain-Collate-Act, i.e. ORCA) loop that feeds sensor observations (state, RGB image, force/torque) through a Policy neural network to produce control commands for drone flight, while maintaining rolling history buffers for sequence models.",
      "tags": ["controller", "inference", "data-model", "orca-loop", "policy-runtime"],
      "complexity": "complex",
      "languageNotes": "Maintains GPU tensor buffers for current/previous state and a rolling sequence history dict (Sqc) indexed circularly via sqc_idx, avoiding reallocation on every timestep for real-time control."
    },
    {
      "id": "class:src/sousvide/control/pilot.py:Pilot",
      "type": "class",
      "name": "Pilot",
      "filePath": "src/sousvide/control/pilot.py",
      "lineRange": [13, 396],
      "summary": "Runtime controller that wraps a Policy network, managing device placement, image preprocessing, sequence-history buffers, and the observe/retain/collate/act control cycle used both for live deployment (ORCA) and training-time inference.",
      "tags": ["controller", "policy-runtime", "state-machine", "orca-loop"],
      "complexity": "complex"
    },
    {
      "id": "file:src/sousvide/instruct/losses.py",
      "type": "file",
      "name": "losses.py",
      "filePath": "src/sousvide/instruct/losses.py",
      "summary": "Provides loss function utilities for training policy networks: entropy and load-balance regularizers for mixture-of-experts gating weights, and a LossFn class computing summed MSE loss across multiple prediction/label keys.",
      "tags": ["loss-function", "training", "utility", "mixture-of-experts"],
      "complexity": "simple"
    },
    {
      "id": "function:src/sousvide/instruct/losses.py:loss_entropy",
      "type": "function",
      "name": "loss_entropy",
      "filePath": "src/sousvide/instruct/losses.py",
      "lineRange": [4, 5],
      "summary": "Computes the negative mean entropy of a weights tensor, used as a regularization term to encourage diverse gating in mixture-of-experts style networks.",
      "tags": ["loss-function", "regularization", "utility"],
      "complexity": "simple"
    },
    {
      "id": "function:src/sousvide/instruct/losses.py:loss_load_balance",
      "type": "function",
      "name": "loss_load_balance",
      "filePath": "src/sousvide/instruct/losses.py",
      "lineRange": [7, 9],
      "summary": "Computes the variance of mean gating weights across the batch, penalizing imbalanced expert utilization in mixture-of-experts training.",
      "tags": ["loss-function", "regularization", "utility"],
      "complexity": "simple"
    },
    {
      "id": "class:src/sousvide/instruct/losses.py:LossFn",
      "type": "class",
      "name": "LossFn",
      "filePath": "src/sousvide/instruct/losses.py",
      "lineRange": [11, 21],
      "summary": "Callable loss wrapper that sums mean-squared-error losses across all matching keys between predicted and label dictionaries, used as the training criterion for the policy network.",
      "tags": ["loss-function", "training", "callable"],
      "complexity": "simple"
    },
    {
